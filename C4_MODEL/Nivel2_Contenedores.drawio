        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Nodos\n    Usuarios[\&quot;&lt;b&gt;Estudiante / Docente / Autor de preguntas / Revisor / Administrador&lt;/b&gt;&lt;br/&gt;[personas]\&quot;]\n    \n    SPA[\&quot;&lt;b&gt;Aplicación Web (SPA)&lt;/b&gt;&lt;br/&gt;[contenedor: Angular + TypeScript]&lt;br/&gt;&lt;br/&gt;Responsabilidad: interfaz de usuario; recibe y presenta&lt;br/&gt;información a cada rol (Capa de Presentación - cliente)\&quot;]\n    \n    Backend[\&quot;&lt;b&gt;Servidor de Aplicación (Monolito)&lt;/b&gt;&lt;br/&gt;[contenedor: Spring Boot / Java]&lt;br/&gt;&lt;br/&gt;Responsabilidad: expone API REST, aplica reglas de negocio&lt;br/&gt;(autenticación, gestión de preguntas, simulacros, calificación, reportes) y&lt;br/&gt;coordina las capas de Dominio, Acceso a Datos y Transversal\&quot;]\n    \n    BD[(\&quot;&lt;b&gt;Base de Datos&lt;/b&gt;&lt;br/&gt;[contenedor: MariaDB]&lt;br/&gt;&lt;br/&gt;Persiste usuarios, preguntas, simulacros y&lt;br/&gt;resultados\&quot;)]\n    \n    Storage[\&quot;&lt;b&gt;Almacenamiento de Archivos&lt;/b&gt;&lt;br/&gt;[contenedor: Object Storage - S3]&lt;br/&gt;&lt;br/&gt;Almacena imágenes y adjuntos de las&lt;br/&gt;preguntas\&quot;]\n    \n    Correo[\&quot;&lt;b&gt;Servicio de&lt;br/&gt;Correo/Notificaciones&lt;/b&gt;&lt;br/&gt;[sistema externo]&lt;br/&gt;&lt;br/&gt;Notifica a revisores y estudiantes\&quot;]\n\n    %% Relaciones\n    Usuarios --&gt;|\&quot;interactúa mediante HTTPS\&quot;| SPA\n    SPA --&gt;|\&quot;consume API REST/JSON sobre HTTPS\&quot;| Backend\n    Backend --&gt;|\&quot;lee/escribe usando JDBC/SQL\&quot;| BD\n    Backend --&gt;|\&quot;sube/descarga archivos usando SDK/API\&quot;| Storage\n    Backend -. \&quot;envía notificaciones usando SMTP/API\&quot; .-&gt; Correo\n\n    %% Definición de Estilos (Colores originales de la imagen)\n    style Usuarios fill:#1e3320,stroke:#2e5231,color:#ffffff,rx:10,ry:10\n    style SPA fill:#6e8294,stroke:#4b5b69,color:#ffffff,rx:15,ry:15\n    style Backend fill:#1e3854,stroke:#2c527a,color:#ffffff,rx:15,ry:15\n    style BD fill:#542226,stroke:#7d3339,color:#ffffff\n    style Storage fill:#8c759e,stroke:#665474,color:#ffffff,rx:15,ry:15\n    style Correo fill:#1c1e22,stroke:#ffffff,color:#ffffff,stroke-dasharray: 5 5,rx:15,ry:15&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="AHbIvs6jdvdC55y74A7h-1">
