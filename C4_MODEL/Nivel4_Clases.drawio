<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="wMB2LWIDF_tJycyd6R8A">
    <mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    %% Capa de Presentación\n    class PreguntaController {\n        -IPreguntaService preguntaService\n        +crearPregunta(dto: PreguntaDTO) ResponseEntity\n        +editarPregunta(id: Long, dto: PreguntaDTO) ResponseEntity\n        +cambiarEstado(id: Long, estado: EstadoPregunta) ResponseEntity\n    }\n\n    %% Capa de Dominio - Interfaces (DIP)\n    class IPreguntaService {\n        &lt;&lt;interface&gt;&gt;\n        +crearPregunta(pregunta: Pregunta) Pregunta\n        +actualizarPregunta(id: Long, pregunta: Pregunta) Pregunta\n        +cambiarEstado(id: Long, nuevoEstado: EstadoPregunta) void\n    }\n\n    class IValidadorPregunta {\n        &lt;&lt;interface&gt;&gt;\n        +validarEstructura(pregunta: Pregunta) boolean\n    }\n\n    class IPreguntaRepository {\n        &lt;&lt;interface&gt;&gt;\n        +save(pregunta: Pregunta) Pregunta\n        +findById(id: Long) Optional~Pregunta~\n    }\n\n    %% Capa de Dominio - Servicios e Implementaciones\n    class PreguntaService {\n        -IPreguntaRepository preguntaRepository\n        -IValidadorPregunta validadorPregunta\n        +crearPregunta(pregunta: Pregunta) Pregunta\n        +actualizarPregunta(id: Long, pregunta: Pregunta) Pregunta\n        +cambiarEstado(id: Long, nuevoEstado: EstadoPregunta) void\n    }\n\n    class ValidadorPreguntaImpl {\n        +validarEstructura(pregunta: Pregunta) boolean\n    }\n\n    %% Capa de Dominio - Entidades y Value Objects\n    class Pregunta {\n        -Long id\n        -EstadoPregunta estado\n        +validar() boolean\n    }\n\n    class Contexto {\n        -String texto\n        -String urlImagen\n    }\n\n    class PreguntaDirecta {\n        -String enunciado\n    }\n\n    class Distractor {\n        -String texto\n        -boolean esCorrecta\n    }\n\n    class ClasificacionPregunta {\n        -String competencia\n        -String area\n        -String nivelDificultad\n    }\n\n    class EstadoPregunta {\n        &lt;&lt;enumeration&gt;&gt;\n        BORRADOR\n        EN_REVISION\n        APROBADA\n        RECHAZADA\n        PUBLICADA\n    }\n\n    %% Capa de Acceso a Datos - Implementación concreta\n    class PreguntaRepositoryJPA {\n        +save(pregunta: Pregunta) Pregunta\n        +findById(id: Long) Optional~Pregunta~\n    }\n\n    %% Realizaciones / Implementaciones de Interfaces (DIP)\n    IPreguntaService &lt;|.. PreguntaService\n    IValidadorPregunta &lt;|.. ValidadorPreguntaImpl\n    IPreguntaRepository &lt;|.. PreguntaRepositoryJPA\n\n    %% Dependencias entre Servicios/Controladores e Interfaces\n    PreguntaController --&gt; IPreguntaService\n    PreguntaService --&gt; IPreguntaRepository\n    PreguntaService --&gt; IValidadorPregunta\n\n    %% Relaciones de Dominio / Entidades\n    Pregunta *-- \&quot;1\&quot; Contexto : Composición\n    Pregunta *-- \&quot;1\&quot; PreguntaDirecta : Composición\n    Pregunta *-- \&quot;1..4\&quot; Distractor : Composición\n    Pregunta o-- \&quot;1\&quot; ClasificacionPregunta : Agregación\n    Pregunta --&gt; \&quot;1\&quot; EstadoPregunta : Usa&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="ubyKt6ePcd6j7KyHk4tx-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
        <UserObject label="&lt;b&gt;PreguntaController&lt;/b&gt;" mermaidId="n:PreguntaController" mermaidBaseStyle="swimlane;html=1;fontStyle=1;fontSize=16;align=center;verticalAlign=middle;horizontal=1;childLayout=stackLayout;startSize=48;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginTop=12;marginBottom=12;stackSpacing=0;swimlaneFillColor=light-dark(#ECECFF,#1f2020);whiteSpace=wrap;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;" mermaidBaseValue="&lt;b&gt;PreguntaController&lt;/b&gt;" id="ubyKt6ePcd6j7KyHk4tx-2">
