        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Elementos externos\n    SPA[\&quot;&lt;b&gt;Aplicación Web (SPA)&lt;/b&gt;&lt;br/&gt;[contenedor: Angular]\&quot;]\n    BD[(\&quot;&lt;b&gt;Base de Datos&lt;/b&gt;&lt;br/&gt;[contenedor: MariaDB]\&quot;)]\n    Storage[\&quot;&lt;b&gt;Almacenamiento de Archivos&lt;/b&gt;&lt;br/&gt;[contenedor: S3]\&quot;)]\n    Correo[\&quot;&lt;b&gt;Servicio de Notificaciones&lt;/b&gt;&lt;br/&gt;[sistema externo]\&quot;)]\n\n    %% Contenedor Principal: Servidor de Aplicación\n    subgraph ServidorApp [\&quot;&lt;b&gt;Servidor de Aplicación (Monolito Java / Spring Boot)&lt;/b&gt;\&quot;]\n        \n        %% CAPA DE PRESENTACIÓN\n        subgraph CapaPresentacion [\&quot;Capa de Presentación\&quot;]\n            RESTControllers[\&quot;&lt;b&gt;Controladores REST (API)&lt;/b&gt;&lt;br/&gt;[componentes]&lt;br/&gt;Reciben solicitudes, validan formato,&lt;br/&gt;autentican y retornan respuestas DTO\&quot;]\n        end\n\n        %% CAPA DE DOMINIO\n        subgraph CapaDominio [\&quot;Capa de Dominio\&quot;]\n            DomainServices[\&quot;&lt;b&gt;Servicios de Aplicación y Dominio&lt;/b&gt;&lt;br/&gt;[componentes]&lt;br/&gt;Contienen la lógica de negocio, validaciones,&lt;br/&gt;ciclo de vida y reglas de calificación\&quot;]\n        end\n\n        %% CAPA DE ACCESO A DATOS\n        subgraph CapaAccesoDatos [\&quot;Capa de Acceso a Datos\&quot;]\n            DataRepositories[\&quot;&lt;b&gt;Repositorios y Adaptadores&lt;/b&gt;&lt;br/&gt;[componentes]&lt;br/&gt;Implementan persistencia SQL (JPA),&lt;br/&gt;gestión de archivos S3 y envío de correo\&quot;]\n        end\n\n        %% CAPA TRANSVERSAL\n        subgraph CapaTransversal [\&quot;Capa Transversal\&quot;]\n            CrossCutting[\&quot;&lt;b&gt;Servicios Transversales&lt;/b&gt;&lt;br/&gt;[componentes]&lt;br/&gt;Seguridad (JWT), manejo centralizado de excepciones,&lt;br/&gt;logging y validadores genéricos\&quot;]\n        end\n\n    end\n\n    %% RELACIONES ENTRE COMPONENTES Y CAPAS\n    SPA --&gt;|\&quot;HTTPS / REST / JSON\&quot;| RESTControllers\n    \n    RESTControllers --&gt; DomainServices\n    DomainServices --&gt; DataRepositories\n    \n    DataRepositories --&gt;|\&quot;JDBC / SQL\&quot;| BD\n    DataRepositories --&gt;|\&quot;SDK / API\&quot;| Storage\n    DataRepositories -.-&gt;|\&quot;SMTP / API\&quot;| Correo\n\n    %% USO DE TRANSVERSALES\n    CapaPresentacion -.-&gt; CrossCutting\n    CapaDominio -.-&gt; CrossCutting\n    CapaAccesoDatos -.-&gt; CrossCutting\n\n    %% ESTILOS VISUALES\n    style ServidorApp fill:#111625,stroke:#2c527a,color:#ffffff\n    \n    style CapaPresentacion fill:#263238,stroke:#455a64,color:#ffffff\n    style CapaDominio fill:#1b3a4b,stroke:#006494,color:#ffffff\n    style CapaAccesoDatos fill:#2d1b36,stroke:#6a040f,color:#ffffff\n    style CapaTransversal fill:#3d3a00,stroke:#857c00,color:#ffffff\n\n    style SPA fill:#3a506b,stroke:#5bc0be,color:#ffffff,rx:10,ry:10\n    style BD fill:#4a1525,stroke:#a4133c,color:#ffffff\n    style Storage fill:#4c3b5c,stroke:#7209b7,color:#ffffff,rx:10,ry:10\n    style Correo fill:#212529,stroke:#6c757d,color:#ffffff,stroke-dasharray: 5 5,rx:10,ry:10&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="Ws82QmCEnclMcZ1gGAhV-60">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
