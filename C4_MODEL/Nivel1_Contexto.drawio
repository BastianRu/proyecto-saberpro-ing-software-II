        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;graph TD\n    %% Nodos principales\n    Estudiante[\&quot;&lt;b&gt;👤 Estudiante&lt;/b&gt;&lt;br/&gt;[persona]&lt;br/&gt;&lt;br/&gt;Un usuario del sistema que tenga una&lt;br/&gt;cuenta registrada en el rol de estudiante\&quot;]\n    Docente[\&quot;&lt;b&gt;👤 Docente&lt;/b&gt;&lt;br/&gt;[persona]&lt;br/&gt;&lt;br/&gt;Un usuario del sistema que tenga una&lt;br/&gt;cuenta registrada en el rol de docente\&quot;]\n    Autor[\&quot;&lt;b&gt;🎨 Autor de preguntas&lt;/b&gt;&lt;br/&gt;[persona]&lt;br/&gt;&lt;br/&gt;Un usuario del sistema que tenga una&lt;br/&gt;cuenta registrada en el rol de autor de&lt;br/&gt;preguntas\&quot;]\n    Revisor[\&quot;&lt;b&gt;🔍 Revisor&lt;/b&gt;&lt;br/&gt;[persona]&lt;br/&gt;&lt;br/&gt;Un usuario del sistema que tenga una&lt;br/&gt;cuenta registrada en el rol de revisor\&quot;]\n    \n    Sistema[\&quot;&lt;b&gt;💻 Sistema Banco de Preguntas&lt;br/&gt;Saber Pro&lt;/b&gt;&lt;br/&gt;[sistema de software]&lt;br/&gt;&lt;br/&gt;Permite construir, validar y administrar un&lt;br/&gt;banco de preguntas y generar simulacros&lt;br/&gt;para la preparación de las pruebas Saber&lt;br/&gt;Pro\&quot;]\n    \n    Administrador[\&quot;&lt;b&gt;⚙️ Administrador&lt;/b&gt;&lt;br/&gt;[persona]&lt;br/&gt;&lt;br/&gt;Usuario registrado en el rol de&lt;br/&gt;administrador del sistema\&quot;]\n    Correo[\&quot;&lt;b&gt;📧 Servicio de&lt;br/&gt;Correo/Notificaciones&lt;/b&gt;&lt;br/&gt;[sistema externo]&lt;br/&gt;&lt;br/&gt;Envía notificaciones por correo electrónico\&quot;]\n\n    %% Relaciones\n    Estudiante -. \&quot;presenta simulacros y visualiza&lt;br/&gt;sus métricas usando\&quot; .-&gt; Sistema\n    Docente -. \&quot;Visualiza los reportes de&lt;br/&gt;simulacros por medio de\&quot; .-&gt; Sistema\n    Autor -. \&quot;Crea preguntas para simulacros&lt;br/&gt;por medio de\&quot; .-&gt; Sistema\n    Revisor -. \&quot;Evalúa preguntas usando\&quot; .-&gt; Sistema\n    Administrador -. \&quot;gestiona usuarios y configuración usando\&quot; .-&gt; Sistema\n    Sistema -. \&quot;envía notificaciones usando\&quot; .-&gt; Correo\n\n    %% Definición de Estilos (Colores y formas)\n    %% Personas (Tonos tierra y dorado)\n    style Estudiante fill:#8d6e63,stroke:#5d4037,color:#ffffff,rx:15,ry:15\n    style Docente fill:#8d6e63,stroke:#5d4037,color:#ffffff,rx:15,ry:15\n    style Autor fill:#bf9b30,stroke:#8e7023,color:#ffffff,rx:15,ry:15\n    style Revisor fill:#bf9b30,stroke:#8e7023,color:#ffffff,rx:15,ry:15\n    style Administrador fill:#bf9b30,stroke:#8e7023,color:#ffffff,rx:15,ry:15\n\n    %% Sistemas (Azules y púrpuras)\n    style Sistema fill:#3498db,stroke:#2171a9,color:#ffffff,rx:15,ry:15\n    style Correo fill:#9b59b6,stroke:#76448a,color:#ffffff,stroke-dasharray: 5 5,rx:15,ry:15\n\n    %% Estilos de enlaces (Conectores)\n    linkStyle 0,1,2,3,4,5 stroke:#7f8c8d,stroke-width:1px,stroke-dasharray: 5 5;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="X44aUSl7ny6fFXOQQDwI-1">
