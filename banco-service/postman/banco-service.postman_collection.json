  "item": [
    {
      "name": "Listar todas las preguntas",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8082/preguntas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["preguntas"]
        }
      }
    },
    {
      "name": "Filtrar preguntas por dificultad y estado",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:8082/preguntas?state=BORRADOR&difficulty=MEDIA",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["preguntas"],
          "query": [
            { "key": "state", "value": "BORRADOR" },
            { "key": "difficulty", "value": "MEDIA" }
          ]
        }
      }
    },
    {
      "name": "Obtener pregunta por ID",
      "request": {
        "method": "GET",
        "header": [],
