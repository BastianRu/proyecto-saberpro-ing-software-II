          "port": "8082",
          "path": ["preguntas", "P-001"]
        }
      }
    },
    {
      "name": "Crear pregunta en Borrador",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Patron Strategy\",\n  \"context\": \"El patron Strategy permite definir una familia de algoritmos intercambiables.\",\n  \"directQuestion\": \"Cual es el proposito principal del patron Strategy?\",\n  \"options\": [\n    \"Encapsular algoritmos dentro de clases intercambiables\",\n    \"Garantizar una sola instancia de una clase\",\n    \"Adaptar la interfaz de una clase a otra esperada\",\n    \"Notificar cambios a multiples observadores\",\n    \"Construir objetos complejos paso a paso\"\n  ],\n  \"correctIndex\": 0,\n  \"justification\": \"Strategy encapsula algoritmos y permite intercambiarlos en tiempo de ejecucion.\",\n  \"bibliography\": \"Gamma et al. Design Patterns.\",\n  \"competence\": \"Diseno de software\",\n  \"topic\": \"Patrones de diseno\",\n  \"subtopic\": \"Strategy\",\n  \"difficulty\": \"MEDIA\"\n}"
        },
        "url": {
          "raw": "http://localhost:8082/preguntas",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["preguntas"]
        }
      }
    },
    {
      "name": "Cambiar estado de una pregunta",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"state\": \"PENDIENTE_REVISION\"\n}"
        },
        "url": {
          "raw": "http://localhost:8082/preguntas/P-001/estado",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8082",
          "path": ["preguntas", "P-001", "estado"]
        }
      }
    },
