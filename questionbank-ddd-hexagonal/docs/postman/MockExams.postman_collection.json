{
  "info": {
    "name": "Taller 11 - Mock exams (extension)",
    "description": "Mock exam bounded context on top of the Workshop 10 question bank. Uses the sample data (quiz 1, student 5, teacher 4). Restart the app to reset.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 List quizzes (question bank)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/quizzes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "quizzes"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Start attempt (student 5, quiz 1)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/mock-exams/attempts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "mock-exams",
            "attempts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quizId\": 1,\n  \"studentId\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"attemptId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
